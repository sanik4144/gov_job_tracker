PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gov_job_tracker
DNS_SERVERS=1.1.1.1,8.8.8.8

TELEGRAM_BOT_TOKEN=123456:replace_me
# Bot username without the leading @ — used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=govjobtracker_bot
# Random string; Telegram echoes it back on every webhook update. Required.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_string
# Public HTTPS origin of this backend (your Render URL), no trailing slash.
PUBLIC_BACKEND_URL=https://your-service.onrender.com
# Minutes a Connect Telegram code stays valid.
TELEGRAM_LINK_TTL_MINUTES=15

JOB_SEARCH_URL=https://alljobs.teletalk.com.bd

CRON_SECRET=replace_with_a_long_random_string
JWT_SECRET=replace_with_another_long_random_string
JWT_EXPIRES_IN=7d
ENABLE_INTERNAL_SCHEDULER=false
NOTIFICATION_CATCHUP_MINUTES=360
NOTIFICATION_RETRY_MINUTES=10
NOTIFICATION_JOB_LOOKBACK_DAYS=14
# Days a lapsed paid plan keeps working, to absorb manual payment verification lag.
SUBSCRIPTION_GRACE_DAYS=3
# How long an unverified renewal keeps an existing subscriber on their plan.
PAYMENT_HOLD_DAYS=3
# bKash number shown to users for manual payments.
BKASH_NUMBER=01700000000
TZ=Asia/Dhaka

FRONTEND_ORIGIN=http://localhost:5173

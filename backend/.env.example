PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gov_job_tracker
DNS_SERVERS=1.1.1.1,8.8.8.8

TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_CHAT_ID=123456789

# Seed keyword used on first startup/check. More keywords are managed from the frontend.
JOB_KEYWORD=Assistant Programmer
JOB_SEARCH_URL=https://alljobs.teletalk.com.bd/jobs?keyword=Assistant+Programmer&orgid=1

CRON_SECRET=replace_with_a_long_random_string
DAILY_CRON=0 9 * * *
TZ=Asia/Dhaka

FRONTEND_ORIGIN=http://localhost:5173
